page{background:#f5f7f2;color:#294336;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:26rpx}view,text,button,input{box-sizing:border-box}button{padding:0;margin:0;font-size:24rpx;color:inherit;background:transparent;line-height:1.5}button::after{border:0}.page{padding:32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}.card{background:#fff;border:1rpx solid #e5eadf;border-radius:30rpx;padding:35rpx;margin-bottom:25rpx}.row{display:flex;align-items:center;justify-content:space-between}.muted{color:#8f9c86;font-size:23rpx;line-height:1.8}.eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#9aa58f}.title{font-size:42rpx;font-weight:600;line-height:1.5;margin:15rpx 0}.section-label{font-size:25rpx;font-weight:550}.pill{background:#eff4e6;border-radius:40rpx;padding:9rpx 17rpx;font-size:20rpx;color:#7c9864}.track{height:22rpx;border-radius:20rpx;background:#eef2e8;overflow:hidden}.track-fill{height:100%;border-radius:20rpx;background:linear-gradient(90deg,#a3bd77,#d5e995);transition:width 1s linear}.primary{background:#365f46;color:#f8fbef;border-radius:18rpx;padding:25rpx;text-align:center;font-size:27rpx;font-weight:550}.secondary{padding:18rpx 22rpx;border:1rpx solid #dce5d2;border-radius:14rpx;font-size:23rpx;color:#6f8960}.small-btn{border:1rpx solid #dce5d2;border-radius:12rpx;padding:9rpx 17rpx;font-size:22rpx}.hint{color:#9ba68e;font-size:20rpx;line-height:1.8}.field-label{display:block;font-size:24rpx;margin:30rpx 0 15rpx}.input{border:1rpx solid #dce4d3;background:#f9fbf5;border-radius:15rpx;padding:23rpx 20rpx;width:100%;height:auto;min-height:82rpx;color:#345038}.fields{display:flex;gap:24rpx}.fields>view{flex:1;min-width:0}.text-button{font-size:23rpx;color:#8a9d75}.error{color:#b1604f;font-size:23rpx;line-height:1.7;padding:15rpx 0}.bottom-note{text-align:center;font-size:20rpx;color:#a1ac95;line-height:1.9;margin-top:24rpx}.switch-row{display:flex;justify-content:space-between;align-items:center;margin-top:28rpx;font-size:24rpx}.divider{border-top:1rpx solid #edf0e7;margin:28rpx 0}.screen-reader{position:absolute;width:1px;height:1px;overflow:hidden}
