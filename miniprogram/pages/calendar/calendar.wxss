.calendar{padding:28rpx;margin-top:30rpx}.calendar-nav{margin-bottom:30rpx}.week,.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10rpx}.week{text-align:center;font-size:21rpx;color:#a2ad94;margin-bottom:15rpx}.day{position:relative;background:#f7f9f3;border:1rpx solid #edf1e5;border-radius:14rpx;height:91rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#a5ae9a;font-size:27rpx}.day.work{background:#e9f1dd;border-color:#dce7ce;color:#587940}.day.today{box-shadow:inset 0 0 0 3rpx #a5bf7e}.day.empty{visibility:hidden}.day .state{font-size:17rpx;margin-top:3rpx}.star{position:absolute;right:4rpx;bottom:3rpx;font-size:13rpx;color:#a0b27b}.legend{text-align:center;font-size:21rpx;color:#91a278;margin:30rpx 0}.calendar .text-button{font-size:21rpx}.save{margin-top:38rpx}
