<view class="page {{compact ? 'compact' : ''}}">
 <view class="row"><text class="eyebrow">MAKE EVERY SECOND COUNT</text><view class="row actions"><button class="small-btn" bindtap="togglePrivacy" aria-label="切换金额隐藏">{{hiddenMoney ? '◎ 显示' : '◉ 隐藏'}}</button><button class="small-btn" bindtap="openSettings">设置</button></view></view>
 <view wx:if="{{!compact}}" class="intro"><view class="date">{{date}}</view><view class="title">每一秒，都有小收获。</view><view class="muted">今天的努力，正在变成生活的底气。</view></view>
 <view wx:if="{{!saved}}" class="example row"><text>✦ 示例工资，设置一下你的薪情</text><button bindtap="openSettings">去设置 →</button></view>
 <view wx:if="{{!compact}}" class="quick row"><button bindtap="openCalendar"><text>▦ 我的排班</text><text class="hint">点一下，轻松调休</text></button><view><text>距离发薪日 {{paydayDays}}</text><text class="hint">{{paydayDate}}</text></view></view>
 <view class="card income"><view class="row"><text class="section-label">今日已赚</text><text class="pill">● {{status}}</text></view><view class="money"><text class="currency">¥</text>{{hiddenMoney ? '••••.••' : income}}</view><view class="income-note">{{notes}}</view><view class="row progress-head"><text>今日收入进度</text><text>{{percentage}}%</text></view><view class="track"><view class="track-fill" style="width:{{progress}}%"></view></view><view class="row labels"><text>{{start}} 上班</text><text>预计 ¥{{hiddenMoney ? '••••' : daily}}</text><text>{{end}} 下班</text></view><view class="rates"><view><text>每一秒</text><text class="rate">¥{{hiddenMoney ? '•••' : second}}</text><text>细水长流</text></view><view><text>每一分钟</text><text class="rate">¥{{hiddenMoney ? '•••' : minute}}</text><text>积少成多</text></view><view><text>每一小时</text><text class="rate">¥{{hiddenMoney ? '•••' : hour}}</text><text>又近了一点</text></view></view></view>
 <view class="card countdown"><view class="row"><text class="section-label">自由倒计时</text><text class="sun">☀</text></view><view class="muted">{{countCaption}}</view><view class="timer">{{hh}}<text>:</text>{{mm}}<text>:</text>{{ss}}</view><view class="timer-labels">小时　　　分钟　　　秒</view><view class="hint">{{start}} — {{end}} · 认真生活，也要认真下班</view></view>
 <view wx:if="{{!compact}}" class="card"><view class="row"><text class="section-label">把日子，过成小积累</text><view class="tabs"><button class="{{tab === 'month' ? 'selected' : ''}}" data-tab="month" bindtap="changeTab">本月</button><button class="{{tab === 'week' ? 'selected' : ''}}" data-tab="week" bindtap="changeTab">本周</button></view></view><view class="muted period-caption">已累计 · 按当前设置估算</view><view class="period-amount">¥{{hiddenMoney ? '••••.••' : periodEarned}}</view><view class="track thin"><view class="track-fill" style="width:{{periodProgress}}%"></view></view><view class="row labels"><text>{{tab === 'month' ? '本月' : '本周'}} {{periodDays}} 个工作日</text><text>预计 ¥{{hiddenMoney ? '••••' : periodTarget}}</text></view></view>
 <view wx:if="{{!compact}}" class="card"><view class="row"><text class="section-label">今天的小确幸</text><button class="text-button" bindtap="openGoal">换个目标 ↗</button></view><view class="goal-content"><view class="cup">☕</view><view><view class="goal-name">{{goalName}}</view><view class="hint">努力也值得一点甜。</view></view></view><view class="row labels"><text>{{hiddenMoney ? '努力积攒小快乐' : goalMessage}}</text><text>¥{{hiddenMoney ? '•••' : goalPrice}} / 目标</text></view><view class="track thin"><view class="track-fill" style="width:{{goalProgress}}%"></view></view></view>
 <view wx:if="{{!compact}}" class="quote row"><text>✳ {{quote}}</text><button bindtap="nextQuote">换一句 ↻</button></view>
 <view class="row bottom-actions"><button class="text-button" bindtap="toggleCompact">{{compact ? '◱ 完整模式' : '◱ 极简模式'}}</button><button class="text-button" bindtap="showMethod">计算说明 ⓘ</button><button class="text-button" open-type="share">分享小快乐 ↗</button></view><view class="bottom-note">工资仅保存在本机 · 按设备当地时间估算</view>
</view>
